<div id="<%= dom_id post %>">
  <article>

    <div>
      <strong><%= post.title %></strong>
      <small>by
        <%= post.user.username %></small>
    </div>

    <div>
      <p><%= post.body %></p>
    </div>

    <%= render "likes/like", likeable: post %>

    <%= render "comments/comments", post: post %>

  </article>
</div>
