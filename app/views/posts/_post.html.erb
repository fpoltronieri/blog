<div id="<%= dom_id post %>">

  <%= turbo_stream_from post %>
  <article>

    <div>
      <strong><%= post.title %></strong>
      <small>by
        <%= post.user.username %></small>
    </div>

    <div>
      <p><%= post.body %></p>
    </div>

    <div section="likes">
      <%= render "likes/like", likeable: post %>
      <div id="likes_count_<%= dom_id(post) %>">
        <%= post.likes_count %>
        <%= "like".pluralize(post.likes_count) %>
      </div>
    </div>
    <%= render "comments/comments", post: post %>
  </article>
</div>
