<div id="like_button_<%= dom_id(likeable) %>">
  <!-- _like.html.erb -->
  <% user_like = likeable.likes.detect { |l| l.user_id == Current.user&.id } %>

  <% if user_like %>
    <%= button_to "Unlike",
    [likeable, user_like],
    method: :delete,
    form: {
      data: {
        turbo_stream: true,
      },
    } %>
  <% else %>
    <%= button_to "Like",
    [likeable, :likes],
    method: :post,
    form: {
      data: {
        turbo_stream: true,
      },
    } %>
  <% end %>
</div>
