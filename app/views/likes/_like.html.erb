<%= turbo_frame_tag dom_id(likeable, :likes) do %>
  <% user_like = likeable.likes.find_by(user: current_user) %>
  <div class="likes">
    <span class="likes__count"><%= likeable.likes.size %></span>
    <% if user_like %>
      <%= button_to "Unlike",
      post_like_path(likeable, likeable.user),
      method: :delete,
      class: "btn btn-secondary" %>
    <% else %>
      <%= button_to "Like", [likeable, :likes], method: :post, class: "btn btn-primary" %>
    <% end %>
  </div>
<% end %>
