<div id="<%= dom_id comment %>">
  <p>
    <strong><%= comment.user.username %>:</strong>
    <%= comment.content %>
  </p>

  <%= if comment.user == Current.user
    link_to "Delete",
    post_comment_path(comment.post, comment),
    method: :delete,
    data: {
      confirm: "Are you sure?",
    }
  end %>

</div>
