<div id="<%= dom_id comment %>">
  <p>
    <strong><%= comment.user.username %>:</strong>
    <%= comment.content %>
  </p>

  <%= render "likes/like", likeable: comment %>

  <%= link_to "Delete",
  post_comment_path(comment.post, comment),
  data: {
    turbo_method: :delete,
    turbo_confirm: "Are you sure?",
  } %>

</div>
